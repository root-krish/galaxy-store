Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:app|storage|database|tests|bin|vendor)(?:/|$) - [F,L,NC]
<FilesMatch "(^\.|\.(json|sql|log|md)$|^router\.php$|^composer\.lock$)">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
